[sqlfluff]
# Use the dbt templater and send dbt project root to SQLFluff
templater = dbt
# Set the dbt project directory relative to workspace root
project_dir = .

[sqlfluff:templater:dbt]
profiles_dir = .
dir_ignore = target, .venv, logs, duckdb_warehouse, snapshots, seeds

[sqlfluff:rules]
# enforce consistent formatting without being overly strict on dialect.
rule_ignore = L009,L031,ST06
