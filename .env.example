# SQL Server OLTP source
OLTP_HOST=your_sql_server_host
OLTP_PORT=1433
OLTP_DATABASE=xomdata_dataset
OLTP_USERNAME=your_username
OLTP_PASSWORD=your_password

# DuckDB warehouse path for dbt + DLT
DUCKDB_PATH=data/warehouse.duckdb

# Cosmos DB orchestration metadata
COSMOS_ENDPOINT=https://your-account.documents.azure.com:443/
COSMOS_KEY=your_cosmos_primary_key
COSMOS_DATABASE=xom_ecom
COSMOS_CONTAINER=pipeline_runs
